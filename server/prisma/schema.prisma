generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  ADMIN
  STAFF
}

enum MembershipStatus {
  ACTIVE
  REMOVED
}

enum EmailTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum TeamRole {
  LEADER
  MEMBER
}

/// Same powers, only the label differs (README 0.2).
enum LeaderTitle {
  HEAD
  LEAD
  MANAGER
}

enum TicketKind {
  COMPLAINT
  TASK
}

/// README 0.5
enum TicketStage {
  PENDING_APPROVAL
  AT_CATEGORY
  AT_TEAM
  ASSIGNED
  IN_PROGRESS
  TEAM_REVIEW
  ADMIN_REVIEW
  DONE
  REJECTED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationType {
  NEEDS_APPROVAL
  AT_CATEGORY
  AT_TEAM
  ASSIGNED_TO_YOU
  NEEDS_TEAM_REVIEW
  NEEDS_ADMIN_REVIEW
  SENT_BACK
  TICKET_DONE
  CUSTOMER_DONE
  CUSTOMER_REJECTED
}

enum NotificationStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  name            String
  passwordHash    String
  emailVerifiedAt DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  sessions        Session[]
  emailTokens     EmailToken[]
  memberships     Membership[]
  activities      TicketActivity[] @relation("ActivityActor")
  comments        Comment[]

  @@map("users")
}

model Session {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  lastUsedAt DateTime  @default(now())
  revokedAt  DateTime?
  userAgent  String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model EmailToken {
  id        String         @id @default(uuid())
  userId    String
  type      EmailTokenType
  tokenHash String         @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_tokens")
}

model Organization {
  id            String   @id @default(uuid())
  name          String
  slug          String   @unique
  portalEnabled Boolean  @default(false)
  portalIntro   String?
  ticketCounter Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships Membership[]
  invitations Invitation[]
  teams       Team[]
  categories  Category[]
  tickets     Ticket[]

  @@map("organizations")
}

model Membership {
  id             String           @id @default(uuid())
  organizationId String
  userId         String
  role           MembershipRole
  status         MembershipStatus @default(ACTIVE)
  /// Free text, information only ("Network security engineer").
  jobTitle       String?
  createdAt      DateTime         @default(now())
  removedAt      DateTime?

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitationsSent Invitation[]     @relation("InvitedBy")
  teamMemberships TeamMember[]
  ledCategories   Category[]       @relation("CategoryLead")
  assignments     TicketAssignee[]
  createdTickets  Ticket[]         @relation("CreatedBy")

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@map("memberships")
}

model Invitation {
  id                    String         @id @default(uuid())
  organizationId        String
  email                 String
  role                  MembershipRole
  jobTitle              String?
  teamId                String?
  teamRole              TeamRole?
  leaderTitle           LeaderTitle?
  tokenHash             String         @unique
  invitedByMembershipId String
  expiresAt             DateTime
  acceptedAt            DateTime?
  revokedAt             DateTime?
  createdAt             DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    Membership   @relation("InvitedBy", fields: [invitedByMembershipId], references: [id], onDelete: Cascade)
  team         Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@index([organizationId, email])
  @@map("invitations")
}

model Category {
  id               String    @id @default(uuid())
  organizationId   String
  name             String
  nameKey          String
  description      String?
  leadMembershipId String?
  archivedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Membership?  @relation("CategoryLead", fields: [leadMembershipId], references: [id], onDelete: SetNull)
  teams        Team[]
  tickets      Ticket[]

  @@unique([organizationId, nameKey])
  @@map("categories")
}

model Team {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  // Trimmed, lowercased name: makes "IT" and " it " the same team (case-insensitive unique).
  nameKey        String
  description    String?
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// A team can be in several categories; each shows on the complaint form (D-31).
  categories   Category[]
  members      TeamMember[]
  tickets      Ticket[]
  invitations  Invitation[]

  @@unique([organizationId, nameKey])
  @@map("teams")
}

/// One LEADER per team is enforced by a partial unique index (migration SQL).
model TeamMember {
  id             String       @id @default(uuid())
  organizationId String
  teamId         String
  membershipId   String
  role           TeamRole     @default(MEMBER)
  leaderTitle    LeaderTitle?
  createdAt      DateTime     @default(now())

  team       Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([teamId, membershipId])
  @@index([membershipId])
  @@map("team_members")
}

model Ticket {
  id                    String         @id @default(uuid())
  organizationId        String
  // Per-organization reference number (shown as T-42), from organizations.ticketCounter.
  number                Int
  kind                  TicketKind
  stage                 TicketStage
  subject               String
  description           String
  priority              TicketPriority @default(MEDIUM)
  dueDate               DateTime?      @db.Date
  progress              Int            @default(0)
  /// Set when the work is given to a temporary group (D-26).
  groupName             String?
  categoryId            String?
  teamId                String?
  createdByMembershipId String? // tasks only
  // Customer (complaints only). Not a user account (D-22).
  customerName          String?
  customerEmail         String?
  customerPhoneCode     String?
  customerPhone         String?
  trackingTokenHash     String?        @unique
  /// Reason for REJECTED (shown to the customer).
  closeNote             String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  finishedAt            DateTime?

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  team         Team?            @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdBy    Membership?      @relation("CreatedBy", fields: [createdByMembershipId], references: [id], onDelete: SetNull)
  assignees    TicketAssignee[]
  checklist    ChecklistItem[]
  activities   TicketActivity[]
  comments     Comment[]

  @@unique([organizationId, number])
  @@index([organizationId, stage])
  @@index([organizationId, teamId])
  @@index([organizationId, categoryId])
  @@index([organizationId, updatedAt])
  @@map("tickets")
}

/// Current and past assignees. active=false rows keep history and visibility.
model TicketAssignee {
  id             String    @id @default(uuid())
  organizationId String
  ticketId       String
  membershipId   String
  active         Boolean   @default(true)
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())
  removedAt      DateTime?

  ticket     Ticket     @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([ticketId, membershipId])
  @@index([membershipId])
  @@map("ticket_assignees")
}

model ChecklistItem {
  id                 String         @id @default(uuid())
  organizationId     String
  ticketId           String
  title              String
  priority           TicketPriority @default(MEDIUM)
  dueDate            DateTime?      @db.Date
  doneAt             DateTime?
  doneByMembershipId String?
  position           Int            @default(0)
  createdAt          DateTime       @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, position])
  @@map("checklist_items")
}

/// Append-only history entry. actorUserId = null means "system" or "customer".
model TicketActivity {
  id             String   @id @default(uuid())
  organizationId String
  ticketId       String
  actorUserId    String?
  action         String
  fromValue      String?
  toValue        String?
  note           String?
  createdAt      DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor  User?  @relation("ActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@map("ticket_activities")
}

/// Internal comment between staff. Plain text, immutable.
model Comment {
  id             String   @id @default(uuid())
  organizationId String
  ticketId       String
  authorUserId   String
  body           String
  createdAt      DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("comments")
}

/// Email outbox. Rows are written in the same transaction as the change and
/// sent later by the poller. Payload holds ids only - never tokens or content.
model Notification {
  id             String             @id @default(uuid())
  organizationId String
  toEmail        String
  type           NotificationType
  payload        Json
  status         NotificationStatus @default(PENDING)
  attempts       Int                @default(0)
  nextAttemptAt  DateTime           @default(now())
  claimedAt      DateTime?
  lastError      String?
  sentAt         DateTime?
  createdAt      DateTime           @default(now())

  @@index([status, nextAttemptAt])
  @@map("notifications")
}
